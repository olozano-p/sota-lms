# Copy to .env and fill in — .env is git-ignored. Every variable the app reads is listed here.

# Public origin the app is served on, and the port the Node server listens on.
APP_URL=http://localhost:3003
PORT=3003

# Postgres. The compose.dev.yml stack exposes it on 5433 to leave a local Postgres alone.
DATABASE_URL=postgres://sota:sota@localhost:5433/sota

# Signs sessions and one-time links: ≥ 32 random bytes (openssl rand -base64 32). Required in production.
SESSION_SECRET=

# Default language when nothing else decides (ca | es | en); overrides the theme's defaultLocale. Optional.
DEFAULT_LOCALE=

# Directory with theme.json, custom.css, messages/, emails/, assets/ and slots/ (docs/theming.md).
# Empty: ./theme if it exists, else the shipped look. Slots are compiled in at build time.
THEME_DIR=

# Who owns identity (docs/configuration.md, ADR-013).
#   local: email + password, magic link, admin invitations. Needs nothing but Postgres.
#   oidc:  sign-in through your identity provider; no local registration. Needs the OIDC_* block.
AUTH_MODE=local

# local mode: let anyone register. Off, people come by invitation (`pnpm create-admin` makes the
# first admin; until an admin exists the first sign-up becomes one). Ignored in oidc mode.
ALLOW_SIGNUP=false

# oidc mode: the one address that may still sign in with a password at /login/break-glass if the
# IdP is down. Create it with `pnpm create-admin`. Leave empty to have none.
BREAK_GLASS_ADMIN_EMAIL=

# oidc mode: OIDC relying party. Discovery at ${OIDC_ISSUER}/.well-known/openid-configuration.
# Redirect URI to register: ${APP_URL}/api/auth/callback/oidc
# The values below point at the mock IdP in dev/mock-idp (compose.dev.yml or `pnpm mock-idp`);
# set AUTH_MODE=oidc to use it.
OIDC_ISSUER=http://localhost:3013
OIDC_CLIENT_ID=sota
OIDC_CLIENT_SECRET=sota-dev-secret
# Scopes requested (space or comma separated).
OIDC_SCOPES="openid profile email"
# Name of the ID-token claim carrying the roles array (docs/idp-integration.md).
OIDC_ROLES_CLAIM=roles
# Only if the IdP's discovery document lacks end_session_endpoint: where logout also signs out of the IdP.
OIDC_END_SESSION_URL=
# Optional: name of an ID-token claim holding [{course, cohort?, until?}] to enroll people at sign-in.
# The mock IdP sends one called "enrollments".
ENTITLEMENT_CLAIM=

# Enrollment contract (docs/entitlements-contract.md; the variable names predate ADR-014).
# Pull: GET ${ENTITLEMENTS_PULL_URL}/{sub}.
ENTITLEMENTS_PULL_URL=http://localhost:3013/entitlements/v1
ENTITLEMENTS_PULL_TOKEN=sota-dev-pull-token
# Push: the source POSTs to ${APP_URL}/api/webhooks/entitlements signed with this secret.
ENTITLEMENTS_WEBHOOK_SECRET=sota-dev-webhook-secret
# Reserved for v1.1 write-back of manual enrollments; unused today.
ENTITLEMENTS_WRITE_URL=

# File storage. `local` (default) keeps files under STORAGE_DIR and serves them itself; `s3` uses
# the S3_* block below. STORAGE_DIR is required in production and must survive deploys.
STORAGE_DRIVER=local
STORAGE_DIR=data/uploads

# Only when STORAGE_DRIVER=s3: any S3 API; the bucket must exist and be private.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Origin browsers use when it differs from S3_ENDPOINT (e.g. a proxy hostname in front of the store).
S3_PUBLIC_ENDPOINT=

# Mail. MAIL_TRANSPORT=console prints messages to stdout (dev); smtp uses the SMTP_* settings.
MAIL_TRANSPORT=console
MAIL_FROM='SOTA <lms@example.invalid>'
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Vimeo personal access token with `private` + `video_files` scopes; used to resolve video metadata.
VIMEO_ACCESS_TOKEN=

# Cookie domain for the locale cookie, so a parent site can share it. The session cookie is always host-only.
COOKIE_DOMAIN=

# Behind a reverse proxy: trust X-Forwarded-For for rate limiting.
TRUST_PROXY=false
# Notification tick interval for scripts/serve.mjs in ms; 0 when cron runs `pnpm notify` instead.
NOTIFY_INTERVAL_MS=900000
