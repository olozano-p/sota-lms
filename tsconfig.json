{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    // src/db, src/config and scripts run under Node's native TypeScript (no bundler), which needs
    // explicit .ts extensions on relative imports. Harmless for the Vite-bundled code.
    "allowImportingTsExtensions": true,
    "types": ["node", "vite/client"],
    "paths": {
      "~/*": ["./src/*"]
    }
  },
  "include": [
    "src",
    "scripts",
    "tests",
    "lms.config.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "drizzle.config.ts",
    "playwright.config.ts"
  ]
}
