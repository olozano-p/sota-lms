{
  "name": "sota",
  "version": "0.1.0",
  "private": true,
  "description": "SOTA — a lean, self-hostable LMS that relies on your identity provider",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node scripts/serve.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node src/db/migrate.ts",
    "db:seed": "node scripts/seed.ts",
    "mock-idp": "node dev/mock-idp/server.mjs",
    "notify": "node scripts/notify.ts",
    "create-admin": "node --env-file-if-exists=.env scripts/create-admin.ts",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.900.0",
    "@aws-sdk/s3-request-presigner": "^3.900.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@tanstack/react-form": "^1.20.0",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.35",
    "@tanstack/react-start": "^1.168.52",
    "@tanstack/react-table": "^8.21.3",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-image": "3.31.3",
    "@tiptap/extensions": "3.31.3",
    "@tiptap/markdown": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "@vimeo/player": "^2.29.0",
    "better-auth": "^1.7.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "isomorphic-dompurify": "^2.28.0",
    "lucide-react": "^1.44.0",
    "marked": "^17.0.0",
    "nodemailer": "^9.1.1",
    "openid-client": "^6.8.0",
    "pg": "^8.16.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.4.0",
    "uuidv7": "^1.0.2",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@fontsource-variable/literata": "^5.2.0",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/vimeo__player": "^2.18.0",
    "@vitejs/plugin-react": "^6.0.5",
    "drizzle-kit": "^0.31.10",
    "oidc-provider": "^9.5.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.3.0"
}
